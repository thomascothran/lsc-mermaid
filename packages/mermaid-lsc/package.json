{
  "name": "mermaid-lsc",
  "version": "0.0.0",
  "description": "Live Sequence Charts as a Mermaid external diagram",
  "license": "MIT",
  "type": "module",
  "sideEffects": false,
  "exports": {
    ".": {
      "lsc-source": "./src/index.ts",
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    },
    "./node": {
      "lsc-source": "./src/node.ts",
      "types": "./dist/node.d.ts",
      "import": "./dist/node.js"
    }
  },
  "bin": {
    "mermaid-lsc": "./dist/bin.js"
  },
  "files": [
    "dist",
    "src",
    "!src/**/*.test.ts"
  ],
  "scripts": {
    "build": "tsc -b && pnpm bundle",
    "demo": "pnpm bundle && node demo/serve.mjs",
    "bundle": "esbuild src/index.ts --bundle --format=esm --platform=browser --target=es2022 --external:mermaid --conditions=lsc-source --minify --sourcemap --legal-comments=linked --outfile=dist/mermaid-lsc.esm.mjs"
  },
  "dependencies": {
    "jsdom": "^30.1.3",
    "lsc-model": "workspace:*"
  },
  "peerDependencies": {
    "mermaid": "^12.0.0"
  },
  "devDependencies": {
    "@types/jsdom": "^30.0.0",
    "esbuild": "^0.28.2",
    "mermaid": "^12.2.0"
  }
}
