  },
  "files": [
    "dist",
    "src",
    "!src/**/*.test.ts"
  ],
  "scripts": {
    "generate": "langium generate",
    "build": "langium generate && tsc -b"
  },
  "dependencies": {
    "langium": "~4.4.0"
  },
  "devDependencies": {
    "langium-cli": "~4.4.0"
  }
}
