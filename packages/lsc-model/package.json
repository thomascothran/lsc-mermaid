{
  "name": "lsc-model",
  "version": "0.0.0",
  "description": "Parser, semantic model and validator for Live Sequence Charts",
  "license": "MIT",
  "type": "module",
  "sideEffects": false,
  "exports": {
    ".": {
      "lsc-source": "./src/index.ts",
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
