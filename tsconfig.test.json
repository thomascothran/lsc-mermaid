{
  "extends": "./tsconfig.base.json",
  "compilerOptions": {
    "noEmit": true,
    "composite": false,
    "declaration": false,
    "declarationMap": false,
    "lib": ["ES2022", "DOM", "DOM.Iterable"],
    "types": ["node"],
    "allowImportingTsExtensions": true
  },
  "include": [
    "packages/*/src",
    "packages/*/test",
    "site/src",
    "site/test",
    "site/build.ts",
    "site/tutorial",
    "fixtures",
    "vitest.config.ts"
  ]
}
